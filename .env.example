# HarvestMitra AI Environment Variables Configuration Template

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL (For CORS configuration)
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=harvestmitra_db
DB_DIALECT=mysql

# JWT Authentication Secrets
JWT_SECRET=harvestmitra_super_secret_jwt_token_key_2026_hackathon
JWT_EXPIRES_IN=7d

# Provider-Independent AI Service Configuration (Mitra Assistant - ISSUE-09)
# Options: 'gemini', 'openai', or 'fallback'
AI_PROVIDER=gemini

# Gemini API Key (Required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Legacy/Generic AI Key fallback
AI_API_KEY=your_optional_api_key_here

# Optional model override (e.g. 'gemini-1.5-flash', 'gpt-4o-mini')
AI_MODEL=

# AI request timeout in milliseconds
AI_TIMEOUT_MS=15000

# Weather API Integration & District Rain Advisory (ISSUE-11)
WEATHER_API_KEY=your_optional_weather_api_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
RAIN_PROBABILITY_THRESHOLD=60

# Mandi Market API Integration (ISSUE-11)
MARKET_API_KEY=your_optional_market_api_key_here
MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# Demo & Mock Mode (Enabled by default for zero-credential hackathon demonstration)
ENABLE_DEMO_MODE=true
USE_SAMPLE_MARKET_DATA=true
