# HarvestMitra AI Environment Variables Configuration Template

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL (For CORS configuration)
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=harvestmitra_db
DB_DIALECT=mysql

# JWT Authentication Secrets
JWT_SECRET=harvestmitra_super_secret_jwt_token_key_2026_hackathon
JWT_EXPIRES_IN=7d

# Provider-Independent AI Service Configuration
# Options: 'gemini', 'openai', or 'fallback'
AI_PROVIDER=gemini
AI_API_KEY=your_optional_gemini_api_key_here

# Weather API Integration (OpenWeatherMap / WeatherAPI)
WEATHER_API_KEY=your_optional_weather_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Government mandi price feed (data.gov.in / AGMARKNET)
# You can use your data.gov.in API key here for live market rates.
DATA_GOV_API_KEY=your_optional_data_gov_api_key_here

# Demo & Mock Mode (Enabled by default for hackathon demonstration)
ENABLE_DEMO_MODE=true
USE_SAMPLE_MARKET_DATA=true
